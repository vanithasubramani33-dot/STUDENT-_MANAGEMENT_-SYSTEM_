-- 3. Display All Students
SELECT * FROM students;


-- 4. Search Student
SELECT * FROM students
WHERE name LIKE '%Vani%';


-- 5. Update Student
UPDATE students
SET attendance = 95
WHERE roll_no = '101';


-- 6. Delete Student
DELETE FROM students
WHERE roll_no = '104';


-- 7. Count Total Students
SELECT COUNT(*) AS total_students
FROM students;


-- 8. Count Students by Gender
SELECT gender, COUNT(*) AS total_students
FROM students
GROUP BY gender;


-- 9. Count Students by Department
SELECT department, COUNT(*) AS total_students
FROM students
GROUP BY department;


-- 10. Calculate Average Attendance
SELECT AVG(attendance) AS average_attendance
FROM students;
