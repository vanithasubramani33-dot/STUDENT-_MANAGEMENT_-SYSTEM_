-- STUDENT MANAGEMENT SYSTEM DATABASE

-- 1. Create Table
CREATE TABLE students (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    roll_no TEXT NOT NULL UNIQUE,
    email TEXT NOT NULL,
    gender TEXT NOT NULL,
    department TEXT NOT NULL,
    year TEXT NOT NULL,
    attendance REAL NOT NULL
);


